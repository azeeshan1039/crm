DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional alias. Use this instead of DATABASE_URL if you prefer.
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for signed Flask sessions. Set to a long random value.
CRM_SECRET_KEY=change-me

# Where the browser lands after connecting a Gmail account.
CRM_UI_URL=http://localhost:3100

# Google OAuth, only needed for "Save as Gmail drafts".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5050/api/google/callback

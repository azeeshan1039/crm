# Copy this file to crm\.env and fill it in. Only needed for "Save as Gmail drafts".
# Get the values from Google Cloud console > APIs & Services > Credentials (see HANDBOOK.md, section 4).
# Keep crm\.env private - treat the secret like a password and never share it.
#
# To use Neon/Postgres instead of the local SQLite crm.db, add:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional alias:
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# Recommended for any shared/hosted DB:
# CRM_SECRET_KEY=change-me-to-a-long-random-value
#
# Account the local MCP server acts as when creating or editing leads.
# If this is empty and the database has exactly one user, that user is used.
# MCP_USER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5050/api/google/callback
# Where the browser lands after connecting an account
CRM_UI_URL=http://localhost:3100
